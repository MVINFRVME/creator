# Пример nginx для демо PHP + статика (разделы 1–2)
# Bitrix CMS на VM обычно живёт отдельно (порт 8080 / свой vhost).
#
# Перед деплоем проверь свободные порты на VPS:
#   ss -tulpn | grep -E ':80|:443|:8000|:8080'
#
# Типично: 80/443 заняты основным сайтом → демо на :8000
# или отдельный server_name на 80.

upstream php_fpm_web_test {
    # путь к сокету зависит от ОС/пакета PHP
    server unix:/run/php/php8.2-fpm.sock;
    # server 127.0.0.1:9000;
}

server {
    listen 8000;
    # или: listen 80; server_name test.example.com;

    server_name _;
    root /var/www/web_test;
    index index.html index.php;

    charset utf-8;
    client_max_body_size 32m;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~ \.php$ {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_pass php_fpm_web_test;
    }

    # не отдавать секреты и служебное
    location ~* /(\.git|\.env|\.credentials) {
        deny all;
    }

    location ~* \.(md|zip|sh)$ {
        # markdown/гайды можно открывать; zip/sh лучше закрыть на проде
        # deny all;
    }
}

# Если нужен HTTPS (после certbot):
# server {
#     listen 443 ssl http2;
#     server_name test.example.com;
#     ...
# }
